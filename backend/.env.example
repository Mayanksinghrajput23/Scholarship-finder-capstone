PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/scholarmatch
CLIENT_URL=http://localhost:5173

# Use long random strings, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=100

# Max requests per IP per 15 minutes for the whole API
API_RATE_LIMIT_MAX=1000
